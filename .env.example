# ── App ──
APP_NAME="RAG API"
APP_VERSION="1.1.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── LLM (Groq) ──
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY="cole-sua-chave-aqui"
GROQ_MODEL="openai/gpt-oss-120b"
LLM_TEMPERATURE=0.2

# ── Embeddings ──
EMBEDDINGS_MODEL="nomic-ai/nomic-embed-text-v1.5"

# ── RAG ──
PDF_PATH="data/exemplo.pdf"
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVER_K=5

# ── CORS (separar por vírgula) ──
CORS_ORIGINS=["*"]
